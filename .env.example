# Cursor API key from https://cursor.com/dashboard/integrations
CURSOR_API_KEY=

# Anthropic API key for Claude provider (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Default agent provider: cursor | claude
AGENT_PROVIDER=cursor

# GitLab personal access token with api + write_repository scopes
GITLAB_TOKEN=

# GitLab instance (default: gitlab.com)
GITLAB_HOST=https://gitlab.com

# Default namespace/group path (e.g. my-group or my-username)
GITLAB_NAMESPACE=

# Server port
PORT=3847
